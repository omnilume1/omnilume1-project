# Supabase Connection Keys
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only operational credentials. Do not expose these in the browser or
# commit populated values. The service role is used only by the protected
# expired-room cleanup route; the Cron secret authorizes the scheduler request.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
CRON_SECRET=your_long_random_cron_secret_here

# Push notifications (Web Push). Generate the key pair once with
# `npx web-push generate-vapid-keys`. The public key is sent to browsers; the
# private key and the webhook secret are server-only. VAPID_SUBJECT is a contact
# for push services: a mailto: address or an https URL. PUSH_WEBHOOK_SECRET is
# the same long random value stored in Supabase Vault as `push_webhook_secret`
# (Postgres sends it when it calls /api/internal/push).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=https://omnilume.vercel.app
PUSH_WEBHOOK_SECRET=your_long_random_push_webhook_secret_here

# TMDB API Key (Phase 26)
TMDB_API_KEY=your_tmdb_key_here
# Server-only GIPHY API key for the room chat GIF picker.
GIPHY_API_KEY=

# Optional server-only Cloudflare R2 storage. When all four values are set,
# private room attachments and music uploads use this bucket via the S3 API.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key

# Optional server-only Cloudflare TURN relay for voice and tab sharing (used
# first when both are set). Without any TURN relay, calls use public STUN only
# (members behind strict NATs may not connect).
CLOUDFLARE_TURN_KEY_ID=your_cloudflare_turn_key_id
CLOUDFLARE_TURN_API_TOKEN=your_cloudflare_turn_api_token

# Optional Metered TURN fallback, used only when the Cloudflare pair is unset.
METERED_APP_NAME=your_metered_app_name
METERED_API_KEY=your_metered_api_key
