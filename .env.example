# Supabase Connection Keys
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Server-only operational credentials. Do not expose these in the browser or
# commit populated values. The service role is used only by the protected
# expired-room cleanup route; the Cron secret authorizes the scheduler request.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
CRON_SECRET=your_long_random_cron_secret_here

# TMDB API Key (Phase 26)
TMDB_API_KEY=your_tmdb_key_here
# Server-only GIPHY API key for the room chat GIF picker.
GIPHY_API_KEY=

# Optional server-only Cloudflare R2 storage. When all four values are set,
# private room attachments and music uploads use this bucket via the S3 API.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_BUCKET_NAME=your_r2_bucket_name
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
